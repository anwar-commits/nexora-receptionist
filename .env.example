# Database. MIGRATION_DATABASE_URL owns the schema; DATABASE_URL is the API login (RLS applies).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/doc_receptionist
DATABASE_URL=postgres://dr_api:dr_api_local@localhost:5432/doc_receptionist
API_DB_LOGIN=dr_api

# Auth. Generate each secret with: openssl rand -base64 32
JWT_SECRET=
# 32-byte key, base64, used to encrypt TOTP secrets and other *_enc columns (KMS in production)
DATA_ENCRYPTION_KEY=
# Pepper for hashing OTP codes and phone lookups
HASH_PEPPER=

# SMS for one-time codes: "console" logs codes (development only). Real providers arrive in Phase 13.
SMS_PROVIDER=console

PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
