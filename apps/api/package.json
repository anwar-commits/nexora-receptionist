{
  "name": "@dr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:dev": "tsx --env-file=../../.env src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@dr/contracts": "workspace:*",
    "@dr/db": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.0",
    "luxon": "^3.7.2",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "pg": "^8.13.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
